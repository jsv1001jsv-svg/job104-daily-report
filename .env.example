# 複製成 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，絕不會進版控。
# 正式環境（Modal）不讀這個檔，改用 Modal Secrets。

# --- LINE Messaging API ---
# 取得方式：LINE Developers Console → Messaging API 頻道 → Channel access token（long-lived）
LINE_CHANNEL_ACCESS_TOKEN=
# 用來驗證 webhook 請求真的來自 LINE（HMAC 簽章）
LINE_CHANNEL_SECRET=

# --- LLM（職缺摘要）---
# 任何 OpenAI 相容的 /chat/completions 端點都能用，換供應商只改這三個變數。
#
# 預設 Google AI Studio：免費、不需信用卡，繁體中文品質穩定。
#   取得方式：https://aistudio.google.com → Get API key
#   免費額度依模型約 5-15 RPM / 100-1000 RPD
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash
#
# 其他選項（把上面兩行換掉即可）：
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions
#               免費模型的 ID 以 :free 結尾，例如 deepseek/deepseek-chat-v3:free
#               ⚠️ 免費池多為中國模型，中文輸出可能跑成簡體，需驗證
#   Groq        https://api.groq.com/openai/v1/chat/completions

# --- Firebase ---
# 本機開發**兩個憑證變數都留空** —— compose 會帶入 FIRESTORE_EMULATOR_HOST，
# 連的是模擬器，不需要任何金鑰。
#
# 連雲端時二擇一：
#   FIREBASE_SERVICE_ACCOUNT      service account JSON 的「內容」（Modal 走這條，
#                                 Secrets 只能給環境變數、給不了檔案）
#   GOOGLE_APPLICATION_CREDENTIALS  service account JSON 「檔案的路徑」（一般機器）
# 兩個都設時以 FIREBASE_SERVICE_ACCOUNT 優先。見 src/store/firestore.py。
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=job104-daily-report

# --- 本機 port（只影響本機，容器內部固定 8000 / 8080）---
# 8000 與 8080 常被其他專案佔用，這裡預設避開
API_PORT=8100
FIRESTORE_PORT=8181

# --- 應用設定 ---
APP_ENV=development
LOG_LEVEL=INFO
# 每位使用者每日最多推播幾筆新職缺
MAX_JOBS_PER_DAY=20
# 抓取 104 時每次請求間隔秒數（當好公民，避免造成對方負擔）
SCRAPE_DELAY_SECONDS=1.5

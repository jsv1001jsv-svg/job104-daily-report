# 複製成 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，絕不會進版控。
# 正式環境（Modal）不讀這個檔，改用 Modal Secrets。

# --- LINE Messaging API ---
# 取得方式：LINE Developers Console → Messaging API 頻道 → Channel access token（long-lived）
LINE_CHANNEL_ACCESS_TOKEN=
# 用來驗證 webhook 請求真的來自 LINE（HMAC 簽章）
LINE_CHANNEL_SECRET=

# --- OpenRouter（職缺摘要）---
OPENROUTER_API_KEY=
# 省錢模型，實作前依當下價格與中文品質挑選
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Firebase ---
# 本機開發連模擬器時可留空（FIRESTORE_EMULATOR_HOST 由 compose 帶入）
# 連雲端時填 service account JSON 檔的路徑
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=job104-daily-report

# --- 本機 port（只影響本機，容器內部固定 8000 / 8080）---
# 8000 與 8080 常被其他專案佔用，這裡預設避開
API_PORT=8100
FIRESTORE_PORT=8181

# --- 應用設定 ---
APP_ENV=development
LOG_LEVEL=INFO
# 每位使用者每日最多推播幾筆新職缺
MAX_JOBS_PER_DAY=20
# 抓取 104 時每次請求間隔秒數（當好公民，避免造成對方負擔）
SCRAPE_DELAY_SECONDS=1.5
